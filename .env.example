# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT Secrets for Access and Refresh Tokens
ACCESS_TOKEN_SECRET=your-access-token-secret
REFRESH_TOKEN_SECRET=your-refresh-token-secret

# Vercel Frontend Deployment URL (for CORS and redirects)
FRONTEND_URL=https://your-frontend-domain.vercel.app

# Redis Authentication Password
REDIS_URI=redis://<username>:<password>@<host>:<port>
REDIS_PASSWORD=your-secure-redis-password

# SMTP Mail configuration (Optional: defaults to Ethereal mock email)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-smtp-api-key
SMTP_FROM="Live Quiz" <no-reply@yourdomain.com>
